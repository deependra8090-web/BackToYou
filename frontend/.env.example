# ============================================================
#  BackTome — Frontend Environment Variables  (Vite)
#  Copy this file to .env and fill in real values.
#  All variables MUST start with VITE_ to be exposed to the browser.
#  NEVER put secrets (JWT_SECRET, Cloudinary API_SECRET, etc.) here.
# ============================================================


# ──────────────────────────────────────────────
# API
# ──────────────────────────────────────────────
# URL of your running backend (include trailing slash)
VITE_API_URL=http://localhost:3001/

# If you use port-forwarding / tunnelling (VS Code Dev Tunnels, Codespaces, etc.),
# set this to the forwarded URL instead:
# VITE_API_URL=https://xxxx-3001.devtunnels.ms/
