# BackToYou Backend Environment Configuration

# Server Port
PORT=5000

# MongoDB Connection String (Atlas or Local)
# Example Atlas: mongodb+srv://<user>:<password>@cluster0.mongodb.net/backtoyou?retryWrites=true&w=majority
# Example Local: mongodb://localhost:27017/backtoyou
MONGODB_URI=

# JWT Secret
JWT_SECRET=backtoyou_jwt_secret_key_2026

# Cloudinary Credentials (Optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
